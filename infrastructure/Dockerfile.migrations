FROM node:22-alpine

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

COPY apps/auth/package.json apps/auth/package.json
COPY apps/events/package.json apps/events/package.json
COPY apps/tickets/package.json apps/tickets/package.json
COPY apps/notifications/package.json apps/notifications/package.json
COPY apps/api-gateway/package.json apps/api-gateway/package.json
COPY libs/shared/package.json libs/shared/package.json

RUN pnpm install --frozen-lockfile

COPY apps/auth apps/auth
COPY apps/events apps/events
COPY apps/tickets apps/tickets
COPY apps/notifications apps/notifications

COPY infrastructure/migrate.sh infrastructure/migrate.sh

RUN chmod +x infrastructure/migrate.sh

CMD ["/app/infrastructure/migrate.sh"]
