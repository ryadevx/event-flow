# Shared
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
KAFKA_BROKER=redpanda:9092
KAFKA_SASL_USERNAME=admin
KAFKA_SASL_PASSWORD=change-me-to-a-secure-kafka-password

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Databases
AUTH_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auth_db
EVENTS_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/events_db
TICKETS_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tickets_db
NOTIFICATIONS_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/notifications_db
